---
import { thumbOf, formatDuration, type Episode } from '../lib/data';
interface Props { episode: Episode; eager?: boolean }
const { episode, eager = false } = Astro.props;
const src = thumbOf(episode);
---
<div class="thumb">
  {src
    ? <img src={src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <div class="thumb-placeholder"><span>샘플 · 썸네일이 없습니다</span></div>}
  {episode.duration != null && <span class="len">{formatDuration(episode.duration)}</span>}
</div>
