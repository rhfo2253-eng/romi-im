---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { members, href, contactEmail } from '../lib/data';

interface Props { title?: string; description?: string; current?: string }
const { title, description = '세이마이네임 비공식 팬 아카이브. Romi_Im 채널의 라이브 압축본과 공개 정보를 모아 둡니다.', current = '' } = Astro.props;
const fullTitle = title ? `${title} · Romi_Im` : 'Romi_Im · 세이마이네임 비공식 팬 아카이브';

// 위쪽 바로가기 막대. 모든 화면에서 항상 보인다.
const nav = [
  { key: 'home', label: '홈', path: '/' },
  { key: 'episodes', label: '압축본', path: '/episodes/' },
  { key: 'shorts', label: '쇼츠', path: '/shorts/' },
  { key: 'lives', label: '라이브 기록', path: '/lives/' },
  { key: 'official', label: '공식 채널', path: '/official/' },
  { key: 'calendar', label: '달력', path: '/calendar/' },
  { key: 'members', label: '멤버', path: '/members/' },
  { key: 'discography', label: '디스코그래피', path: '/discography/' },
  { key: 'guide', label: '처음 오신 분께', path: '/guide/' },
  { key: 'about', label: '사이트 소개', path: '/about/' },
  { key: 'principles', label: '운영 원칙', path: '/principles/' },
];

const memberVars = members.map((m) => `--m-${m.id}:${m.color};`).join('');
const memberDarkVars = members.filter((m) => m.colorDark).map((m) => `--m-${m.id}:${m.colorDark};`).join('');
const memberCss = `:root{${memberVars}}
:root[data-theme='dark']{${memberDarkVars}}
@media (prefers-color-scheme: dark){:root:not([data-theme='light']){${memberDarkVars}}}`;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <style is:inline set:html={memberCss}></style>
    <script is:inline>
      (function () {
        function apply() {
          try {
            var t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
            else delete document.documentElement.dataset.theme;
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="nav" transition:persist="site-nav">
      <div class="wrap nav-inner">
        <a class="logo" href={href('/')} aria-label="Romi_Im 홈">
          <span class="logo-mark" aria-hidden="true">R</span>
          <span>Romi_Im</span>
        </a>
        <div class="nav-actions">
          <button class="icon-btn" id="theme-btn" type="button" aria-label="밝은 모드·어두운 모드 바꾸기">
            <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
        </div>
      </div>
      <nav class="quickbar" aria-label="전체 메뉴">
        <div class="wrap quickbar-inner" id="quickbar">
          {nav.map((n) => (
            <a href={href(n.path)} data-key={n.key} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main id="main" transition:name="main">
      <span data-current={current} hidden></span>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer-links">
          <span>비공식 팬 사이트</span>
          <span aria-hidden="true">·</span>
          <a href={href('/principles/')}>운영 원칙</a>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${contactEmail}?subject=${encodeURIComponent('[Romi_Im] 삭제 요청')}`}>삭제 요청({contactEmail})</a>
        </p>
        <p class="footer-note">세이마이네임(SAY MY NAME) 팬이 만든 비공식 사이트이며 소속사와 관계없습니다.</p>
      </div>
    </footer>

    <script>
      function setup() {
        const root = document.documentElement;
        const themeBtn = document.getElementById('theme-btn');
        if (themeBtn && !themeBtn.dataset.ready) {
          themeBtn.dataset.ready = '1';
          themeBtn.addEventListener('click', () => {
            const isDark = root.dataset.theme
              ? root.dataset.theme === 'dark'
              : matchMedia('(prefers-color-scheme: dark)').matches;
            const next = isDark ? 'light' : 'dark';
            root.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch {}
          });
        }
        // 바로가기 막대는 페이지가 바뀌어도 그대로 남으니 현재 위치 표시를 다시 맞추고, 화면 밖이면 보이게 민다
        const current = document.querySelector<HTMLElement>('[data-current]')?.dataset.current ?? '';
        const bar = document.getElementById('quickbar');
        document.querySelectorAll<HTMLAnchorElement>('.quickbar a[data-key]').forEach((a) => {
          if (a.dataset.key !== current) { a.removeAttribute('aria-current'); return; }
          a.setAttribute('aria-current', 'page');
          if (bar) {
            const left = a.offsetLeft - (bar.clientWidth - a.offsetWidth) / 2;
            bar.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
          }
        });
      }
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: var(--text); color: var(--bg); padding: 8px 12px; border-radius: 10px; }
  .skip:focus { left: 8px; }
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; gap: 16px; height: 52px; }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 18px; text-decoration: none; letter-spacing: -0.02em; flex: none; }
  .logo-mark { width: 28px; height: 28px; border-radius: 8px; background: var(--accent); color: #18181b; display: grid; place-items: center; font-size: 16px; }
  .quickbar { border-top: 1px solid var(--line); }
  .quickbar-inner { display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .quickbar-inner::-webkit-scrollbar { display: none; }
  .quickbar a {
    flex: none; padding: 10px 11px; white-space: nowrap; text-decoration: none;
    color: var(--muted); font-weight: 600; font-size: 15px;
  }
  .quickbar a:hover { color: var(--text); }
  .quickbar a[aria-current='page'] { color: var(--text); font-weight: 800; box-shadow: inset 0 -2px 0 var(--accent); }
  .nav-actions { margin-left: auto; display: flex; gap: 4px; }
  .icon-btn { width: 40px; height: 40px; border-radius: 12px; border: 0; background: transparent; color: var(--text); display: grid; place-items: center; cursor: pointer; }
  .icon-btn:hover { background: var(--bg-soft); }
  .i-moon { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: none; }
    :global(:root:not([data-theme='light'])) .i-moon { display: block; }
  }
  .footer { border-top: 1px solid var(--line); padding: 28px 0 40px; font-size: 14px; color: var(--muted); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 6px; font-weight: 600; color: var(--text); }
  .footer-links a { text-underline-offset: 3px; }
  .footer-note { margin-top: 6px; }
</style>
