---
import Base from '../layouts/Base.astro';
import { calendarItems } from '../lib/data';

const items = calendarItems();
const kinds = [
  { key: 'birthday', label: '생일' },
  { key: 'anniversary', label: '기념일' },
  { key: 'release', label: '발매일' },
  { key: 'broadcast', label: '방송·유튜브 출연' },
  { key: 'event', label: '공연·행사' },
  { key: 'episode', label: '압축본 공개' },
];
---
<Base title="달력" current="calendar">
  <header class="page-head">
    <h1>달력</h1>
    <p>생일, 데뷔 기념일, 발매일, 방송·유튜브 출연, 공연·행사, 압축본 공개일.</p>
  </header>

  <div class="cal card" id="cal" data-items={JSON.stringify(items)}>
    <div class="cal-head">
      <button class="icon" type="button" data-move="-1" aria-label="이전 달">‹</button>
      <h2 id="cal-title" aria-live="polite"></h2>
      <button class="icon" type="button" data-move="1" aria-label="다음 달">›</button>
    </div>
    <div class="week" aria-hidden="true">{['일', '월', '화', '수', '목', '금', '토'].map((d) => <span>{d}</span>)}</div>
    <div class="days" id="cal-days"></div>
    <ul class="legend">
      {kinds.map((k) => <li><span class={`k k-${k.key}`}></span>{k.label}</li>)}
    </ul>
  </div>

  <section class="section">
    <div class="section-title"><h2 id="list-title">이달의 날</h2><button class="chip" type="button" id="today-btn">오늘로</button></div>
    <ul class="list" id="cal-list"></ul>
  </section>
</Base>

<script>
  type Item = { date: string; title: string; kind: string; href?: string; source?: string; sample?: boolean; repeat: boolean };

  function setup() {
    const cal = document.getElementById('cal');
    if (!cal) return;
    const items: Item[] = JSON.parse(cal.dataset.items || '[]');
    const title = document.getElementById('cal-title')!;
    const days = document.getElementById('cal-days')!;
    const list = document.getElementById('cal-list')!;
    const listTitle = document.getElementById('list-title')!;
    const now = new Date();
    let y = now.getFullYear();
    let m = now.getMonth();

    const forMonth = (yy: number, mm: number) => items.flatMap((it) => {
      const [iy, im, id] = it.date.split('-').map(Number);
      if (im - 1 !== mm) return [];
      if (it.repeat) return iy <= yy ? [{ ...it, day: id, years: yy - iy }] : [];
      return iy === yy ? [{ ...it, day: id, years: 0 }] : [];
    }).sort((a, b) => a.day - b.day);

    function render() {
      title.textContent = `${y}년 ${m + 1}월`;
      listTitle.textContent = `${m + 1}월의 날`;
      const month = forMonth(y, m);
      const first = new Date(y, m, 1).getDay();
      const total = new Date(y, m + 1, 0).getDate();
      days.replaceChildren();
      for (let i = 0; i < first; i++) days.append(document.createElement('span'));
      for (let d = 1; d <= total; d++) {
        const cell = document.createElement('div');
        cell.className = 'day';
        if (y === now.getFullYear() && m === now.getMonth() && d === now.getDate()) cell.classList.add('today');
        const num = document.createElement('span');
        num.className = 'num';
        num.textContent = String(d);
        cell.append(num);
        const todays = month.filter((it) => it.day === d);
        if (todays.length) {
          const marks = document.createElement('span');
          marks.className = 'marks';
          for (const it of todays) {
            const k = document.createElement('span');
            k.className = `k k-${it.kind}`;
            k.title = it.title;
            marks.append(k);
          }
          cell.append(marks);
          const label = document.createElement('span');
          label.className = 'label';
          label.textContent = todays[0].title;
          cell.append(label);
        }
        days.append(cell);
      }

      list.replaceChildren();
      if (!month.length) {
        const li = document.createElement('li');
        li.className = 'empty';
        li.textContent = '이달 등록된 날 없음';
        list.append(li);
      }
      for (const it of month) {
        const li = document.createElement('li');
        li.className = 'card item';
        const d = document.createElement('span');
        d.className = 'd';
        d.textContent = `${m + 1}/${it.day}`;
        const k = document.createElement('span');
        k.className = `k k-${it.kind}`;
        const t = it.href ? document.createElement('a') : document.createElement('span');
        if (it.href) (t as HTMLAnchorElement).href = it.href;
        t.className = 't';
        t.textContent = it.title + (it.years > 0 ? ` (${it.years}${it.kind === 'birthday' ? '번째' : '주년'})` : '') + (it.sample ? ' (샘플)' : '');
        li.append(d, k, t);
        if (it.source) {
          const s = document.createElement('a');
          s.className = 'source';
          s.href = it.source;
          s.target = '_blank';
          s.rel = 'noopener';
          s.textContent = '출처';
          li.append(s);
        }
        list.append(li);
      }
    }

    cal.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((b) => b.addEventListener('click', () => {
      m += Number(b.dataset.move);
      if (m < 0) { m = 11; y--; }
      if (m > 11) { m = 0; y++; }
      render();
    }));
    document.getElementById('today-btn')!.addEventListener('click', () => { y = now.getFullYear(); m = now.getMonth(); render(); });
    render();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .cal { padding: 16px; }
  .cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .cal-head h2 { font-size: 20px; font-weight: 800; }
  .icon { width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--text); font-size: 22px; cursor: pointer; }
  .week, .days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .week span { text-align: center; font-size: 12px; font-weight: 700; color: var(--muted); padding-bottom: 6px; }
  .days :global(.day) { min-height: 52px; border-radius: 12px; background: var(--bg-soft); padding: 6px; display: flex; flex-direction: column; gap: 3px; overflow: hidden; }
  .days :global(.today) { outline: 2px solid var(--text); outline-offset: -2px; }
  .days :global(.num) { font-size: 13px; font-weight: 700; }
  .days :global(.marks) { display: flex; gap: 3px; flex-wrap: wrap; }
  .days :global(.label) { display: none; font-size: 11px; line-height: 1.3; color: var(--muted); }
  @media (min-width: 760px) {
    .days :global(.day) { min-height: 96px; }
    .days :global(.label) { display: block; }
  }
  :global(.k) { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex: none; }
  :global(.k-birthday) { background: #ff7eb6; }
  :global(.k-anniversary) { background: var(--accent); }
  :global(.k-release) { background: #4c8dff; }
  :global(.k-episode) { background: var(--muted); }
  :global(.k-broadcast) { background: #f97316; }
  :global(.k-event) { background: #10b981; }
  .legend { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .list :global(.item) { padding: 12px 16px; display: flex; align-items: center; gap: 10px; border-radius: var(--radius-sm); }
  .list :global(.d) { font-weight: 800; min-width: 44px; font-variant-numeric: tabular-nums; }
  .list :global(.t) { flex: 1; text-decoration: none; font-weight: 600; }
</style>
