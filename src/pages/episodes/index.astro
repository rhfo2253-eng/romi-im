---
import Base from '../../layouts/Base.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { episodes, members, episodeHref, formatDuration } from '../../lib/data';

const months = [...new Set(episodes.map((e) => e.liveDate.slice(0, 7)))].sort().reverse();
const index = episodes.map((e) => ({
  title: e.title,
  href: episodeHref(e.id),
  members: e.members,
  ym: e.liveDate.slice(0, 7),
  anniv: !!e.anniversary,
  sample: !!e.sample,
  chapters: e.chapters.map((c) => ({ title: c.title, at: formatDuration(c.time), href: episodeHref(e.id, c.time) })),
}));
---
<Base title="압축본" current="episodes">
  <header class="page-head">
    <p class="eyebrow">라이브 압축본</p>
    <h1>압축본</h1>
    <p>제목과 장면 이름으로 찾을 수 있어요. 장면을 누르면 그 시간부터 바로 재생돼요.</p>
  </header>

  <div class="tools" id="ep-tools" data-index={JSON.stringify(index)}>
    <label class="search">
      <span class="sr">검색</span>
      <input class="input" id="q" type="search" placeholder="제목이나 장면 이름 검색 (예: 케이크)" autocomplete="off" />
    </label>
    <div class="chip-row" role="group" aria-label="멤버로 거르기">
      <button class="chip" type="button" data-member="" aria-pressed="true">전체</button>
      {members.map((m) => (
        <button class="chip" type="button" data-member={m.id} aria-pressed="false">
          <span class="dot" style={`background:var(--m-${m.id})`}></span>{m.name}
        </button>
      ))}
    </div>
    <div class="row">
      <select class="input" id="ym" aria-label="연도·월로 거르기">
        <option value="">모든 달</option>
        {months.map((ym) => <option value={ym}>{ym.replace('-', '년 ')}월</option>)}
      </select>
      <button class="chip" type="button" id="anniv" aria-pressed="false">기념일 편만</button>
    </div>
  </div>

  <section id="scene-results" class="scenes" hidden>
    <h2>장면 검색 결과</h2>
    <ul></ul>
  </section>

  <p class="count muted" id="count"></p>
  <div class="grid" id="ep-grid">
    {episodes.map((e) => (
      <div class="ep-item" data-members={e.members.join(' ')} data-ym={e.liveDate.slice(0, 7)} data-anniv={e.anniversary ? '1' : ''}>
        <EpisodeCard episode={e} />
      </div>
    ))}
  </div>
  <p class="empty" id="none" hidden>조건에 맞는 압축본이 없어요.</p>
</Base>

<script>
  type Item = { title: string; href: string; members: string[]; ym: string; anniv: boolean; sample: boolean;
    chapters: { title: string; at: string; href: string }[] };

  function setup() {
    const tools = document.getElementById('ep-tools');
    if (!tools) return;
    const index: Item[] = JSON.parse(tools.dataset.index || '[]');
    const q = document.getElementById('q') as HTMLInputElement;
    const ym = document.getElementById('ym') as HTMLSelectElement;
    const anniv = document.getElementById('anniv') as HTMLButtonElement;
    const chips = [...tools.querySelectorAll<HTMLButtonElement>('[data-member]')];
    const items = [...document.querySelectorAll<HTMLElement>('.ep-item')];
    const scenes = document.getElementById('scene-results')!;
    const sceneList = scenes.querySelector('ul')!;
    const count = document.getElementById('count')!;
    const none = document.getElementById('none')!;
    let member = '';

    const params = new URLSearchParams(location.search);
    if (params.get('q')) q.value = params.get('q')!;
    if (params.get('member')) member = params.get('member')!;

    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, '');

    function apply() {
      const term = norm(q.value);
      let shown = 0;
      sceneList.replaceChildren();
      index.forEach((it, i) => {
        const okMember = !member || it.members.includes(member);
        const okYm = !ym.value || it.ym === ym.value;
        const okAnniv = !anniv.matches('[aria-pressed="true"]') || it.anniv;
        const titleHit = !term || norm(it.title).includes(term);
        const sceneHits = term ? it.chapters.filter((c) => norm(c.title).includes(term)) : [];
        const visible = okMember && okYm && okAnniv && (titleHit || sceneHits.length > 0);
        items[i].hidden = !visible;
        if (visible) shown++;
        if (visible) {
          for (const c of sceneHits) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = c.href;
            const time = document.createElement('span');
            time.className = 'time';
            time.textContent = `▶ ${c.at}`;
            const name = document.createElement('strong');
            name.textContent = c.title;
            const from = document.createElement('span');
            from.className = 'from';
            from.textContent = it.title + (it.sample ? ' (샘플)' : '');
            a.append(time, name, from);
            li.append(a);
            sceneList.append(li);
          }
        }
      });
      scenes.hidden = sceneList.childElementCount === 0;
      count.textContent = `압축본 ${shown}개`;
      none.hidden = shown > 0;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.member === member)));
    }

    q.addEventListener('input', apply);
    ym.addEventListener('change', apply);
    anniv.addEventListener('click', () => {
      anniv.setAttribute('aria-pressed', String(anniv.getAttribute('aria-pressed') !== 'true'));
      apply();
    });
    chips.forEach((c) => c.addEventListener('click', () => { member = c.dataset.member || ''; apply(); }));
    apply();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .tools { display: grid; gap: 12px; margin-bottom: 18px; }
  .row { display: flex; gap: 8px; align-items: center; }
  .row select { width: auto; flex: 1; max-width: 220px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .count { font-size: 14px; margin-bottom: 10px; }
  .scenes { margin-bottom: 22px; }
  .scenes h2 { font-size: 17px; font-weight: 800; margin-bottom: 8px; }
  .scenes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .scenes :global(a) {
    display: grid; grid-template-columns: auto 1fr; column-gap: 12px; row-gap: 2px; align-items: center;
    text-decoration: none; padding: 12px 14px; border-radius: var(--radius-sm);
    background: var(--card); border: 1px solid var(--line);
  }
  .scenes :global(a:hover) { border-color: var(--accent-strong); }
  .scenes :global(.time) { grid-row: span 2; font-weight: 800; font-size: 13px; background: var(--accent); color: var(--accent-ink); padding: 5px 9px; border-radius: 999px; font-variant-numeric: tabular-nums; }
  .scenes :global(.from) { font-size: 13px; color: var(--muted); }
  .ep-item[hidden] { display: none; }
</style>
