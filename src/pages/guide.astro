---
import Base from '../layouts/Base.astro';
import { members, href } from '../lib/data';

const words = [
  { word: '세마넴', mean: '세이마이네임(SAY MY NAME)을 줄여 부르는 말이에요.' },
  { word: '로미', mean: '세이마이네임 팬을 부르는 이름이에요.' },
  { word: '라이브 · 라방', mean: '멤버들이 위버스에서 하는 실시간 방송이에요.' },
  { word: '압축본', mean: '긴 라이브에서 재미있는 부분만 모아 짧게 만든 영상이에요. 이 사이트의 중심이에요.' },
  { word: '장면(챕터)', mean: '압축본 안의 구간이에요. 장면 이름을 누르면 그 시간부터 바로 재생돼요.' },
  { word: '쇼츠', mean: '라이브에서 나온 1분 안팎의 세로 영상이에요.' },
];
---
<Base title="처음 오신 분께" current="guide">
  <header class="page-head">
    <p class="eyebrow">어서 오세요</p>
    <h1>처음 오신 분께</h1>
    <p>세이마이네임이 처음이라면 여기부터 보세요.</p>
  </header>

  <section class="section">
    <div class="section-title"><h2>멤버 이름 읽는 법</h2><a href={href('/members/')}>멤버 보기 →</a></div>
    <div class="names">
      {members.map((m) => (
        <a class="card lift name" href={href(`/members/${m.id}/`)}>
          <span class="dot" style={`background:var(--m-${m.id})`}></span>
          <strong>{m.name}</strong>
        </a>
      ))}
    </div>
    <p class="muted small">이름 옆 동그라미는 멤버 색이에요. 사이트 곳곳에서 누가 나왔는지 이 색 점으로 보여 드려요.</p>
  </section>

  <section class="section">
    <div class="section-title"><h2>자주 나오는 말</h2></div>
    <dl class="words">
      {words.map((w) => (
        <div class="card word">
          <dt>{w.word}</dt>
          <dd>{w.mean}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section">
    <div class="section-title"><h2>이렇게 둘러보세요</h2></div>
    <ol class="steps">
      <li><a href={href('/')}>홈</a>에서 최신 압축본을 봐요.</li>
      <li><a href={href('/episodes/')}>압축본</a>에서 보고 싶은 장면을 검색해요.</li>
      <li><a href={href('/calendar/')}>달력</a>에서 다가오는 기념일을 확인해요.</li>
    </ol>
  </section>
</Base>
<style>
  .names { display: grid; gap: 10px; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 10px; }
  .name { padding: 14px 8px; display: grid; justify-items: center; gap: 6px; font-size: 18px; }
  .small { font-size: 13px; }
  .words { margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .word { padding: 18px; }
  dt { font-size: 18px; font-weight: 800; margin-bottom: 4px; }
  dt::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-strong); margin-right: 8px; vertical-align: middle; }
  dd { margin: 0; color: var(--muted); }
  .steps { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; }
  .steps a { font-weight: 700; }
</style>
