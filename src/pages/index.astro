---
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import MemberDots from '../components/MemberDots.astro';
import SampleBadge from '../components/SampleBadge.astro';
import Thumb from '../components/Thumb.astro';
import { episodes, members, lives, events, discography, photos, href, episodeHref, formatDate, channelUrl } from '../lib/data';

const [latest, ...rest] = episodes;
const recent = rest.slice(0, 4);
const shortsCount = episodes.reduce((n, e) => n + e.shorts.length, 0);
const scheduleCount = events.filter((e) => e.type === 'broadcast' || e.type === 'event').length;

const menu = [
  { name: '압축본', count: `${episodes.length}편`, desc: '장면 이름 검색, 멤버·월별 보기', path: '/episodes/' },
  { name: '쇼츠', count: `${shortsCount}개`, desc: '압축본에서 나온 세로 영상', path: '/shorts/' },
  { name: '사진', count: `게시물 ${photos.length}개`, desc: '공식 X·인스타그램 게시물 모음', path: '/photos/' },
  { name: '멤버', count: `${members.length}명`, desc: '생일, 멤버 색, 출연 압축본', path: '/members/' },
  { name: '라이브 기록', count: `${lives.length}회`, desc: '압축본 없는 라이브 포함 전체 목록', path: '/lives/' },
  { name: '디스코그래피', count: `${discography.length}개`, desc: '발매일, 타이틀곡, 뮤직비디오', path: '/discography/' },
  { name: '달력', count: `일정 ${scheduleCount}개`, desc: '생일, 발매일, 방송 출연, 공연', path: '/calendar/' },
  { name: '처음 오신 분께', count: '용어 6개', desc: '멤버 이름, 팬덤 이름, 자주 쓰는 말', path: '/guide/' },
  { name: '운영 원칙', count: '8개 항목', desc: '싣는 정보 기준, 삭제 요청 방법', path: '/principles/' },
  { name: '사이트 소개', count: '연락처', desc: '비공식 팬 사이트 안내, 문의 메일', path: '/about/' },
  { name: '유튜브 채널', count: '@smn00000', desc: 'Romi_Im 채널로 이동', url: channelUrl },
];

// 다가오는 날은 보는 날짜에 따라 바뀌므로 브라우저에서 계산한다
const days = [
  ...events.map((e) => ({ date: e.date, title: e.title, repeat: e.repeat === 'yearly', birthday: e.type === 'birthday' })),
  ...discography.filter((r) => r.releaseDate).map((r) => ({ date: r.releaseDate!, title: `${r.title} 발매`, repeat: false, birthday: false })),
];
---
<Base current="home">
  <section class="hero">
    <h1>Romi_Im</h1>
    <p class="muted">세이마이네임 위버스 라이브 압축본 모음 · 비공식 팬 사이트</p>
    <form class="search" action={href('/episodes/')} method="get" role="search">
      <label class="sr" for="home-q">압축본 장면 검색</label>
      <input class="input" id="home-q" name="q" type="search" placeholder="장면 이름 검색 (예: 케이크)" autocomplete="off" />
      <button class="btn primary" type="submit">검색</button>
    </form>
  </section>

  <section class="section">
    <div class="section-title"><h2>전체 메뉴</h2></div>
    <ul class="menu">
      {menu.map((m) => (
        <li>
          <a class="card lift item" href={m.url ?? href(m.path!)} target={m.url ? '_blank' : undefined} rel={m.url ? 'noopener' : undefined}>
            <span class="name">{m.name}{m.url && ' ↗'}</span>
            <span class="count">{m.count}</span>
            <span class="desc">{m.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="two">
    <section class="section">
      <div class="section-title"><h2>최신 압축본</h2><a href={href('/episodes/')}>전체 보기</a></div>
      {latest ? (
        <a class="card lift latest" href={episodeHref(latest.id)}>
          <Thumb episode={latest} eager />
          <div class="latest-body">
            <h3>{latest.title}</h3>
            <p class="meta">
              <span>{formatDate(latest.liveDate)} 라이브 · 장면 {latest.chapters.length}개</span>
              <MemberDots ids={latest.members} />
            </p>
            <SampleBadge show={!!latest.sample} />
          </div>
        </a>
      ) : <p class="empty">등록된 압축본 없음</p>}
    </section>

    <section class="section">
      <div class="section-title"><h2>다가오는 날</h2><a href={href('/calendar/')}>달력</a></div>
      <ul class="rows upcoming" id="upcoming" data-days={JSON.stringify(days)}></ul>
    </section>
  </div>

  {recent.length > 0 && (
    <section class="section">
      <div class="section-title"><h2>최근 압축본</h2><a href={href('/episodes/')}>전체 보기</a></div>
      <div class="grid">{recent.map((e) => <EpisodeCard episode={e} />)}</div>
    </section>
  )}
</Base>

<script>
  function renderUpcoming() {
    const ul = document.getElementById('upcoming');
    if (!ul) return;
    const days: { date: string; title: string; repeat: boolean; birthday: boolean }[] = JSON.parse(ul.dataset.days || '[]');
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const list = days.flatMap((d) => {
      const [y, m, day] = d.date.split('-').map(Number);
      if (d.repeat) {
        let next = new Date(today.getFullYear(), m - 1, day);
        if (next < today) next = new Date(today.getFullYear() + 1, m - 1, day);
        const years = next.getFullYear() - y;
        return [{ at: next, title: years > 0 ? `${d.title} (${years}${d.birthday ? '번째' : '주년'})` : d.title }];
      }
      const at = new Date(y, m - 1, day);
      return at >= today ? [{ at, title: d.title }] : [];
    }).sort((a, b) => +a.at - +b.at).slice(0, 5);

    ul.replaceChildren();
    if (!list.length) {
      const li = document.createElement('li');
      li.className = 'muted';
      li.textContent = '등록된 날 없음';
      ul.append(li);
      return;
    }
    for (const item of list) {
      const diff = Math.round((+item.at - +today) / 86400000);
      const li = document.createElement('li');
      const dday = document.createElement('span');
      dday.className = 'dday';
      dday.textContent = diff === 0 ? '오늘' : `D-${diff}`;
      const date = document.createElement('span');
      date.className = 'date';
      date.textContent = `${item.at.getMonth() + 1}/${item.at.getDate()}`;
      const text = document.createElement('span');
      text.textContent = item.title;
      li.append(dday, date, text);
      ul.append(li);
    }
  }
  document.addEventListener('astro:page-load', renderUpcoming);
</script>

<style>
  .hero { padding: 24px 0 4px; display: grid; gap: 6px; }
  .hero h1 { font-size: clamp(30px, 7vw, 40px); font-weight: 800; }
  .search { display: flex; gap: 8px; margin-top: 14px; }
  .search .btn { flex: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .menu { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 720px) { .menu { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  /* 11칸이라 마지막 칸을 넓혀 줄을 맞춘다 */
  .menu li:last-child { grid-column: span 2; }
  .item { height: 100%; padding: 14px; display: grid; gap: 2px; align-content: start; }
  .name { font-size: 16px; font-weight: 800; }
  .count { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .desc { font-size: 13px; color: var(--muted); line-height: 1.45; margin-top: 4px; }

  .two { display: grid; gap: 0 24px; }
  @media (min-width: 860px) { .two { grid-template-columns: 3fr 2fr; } }
  .latest { padding: 8px; }
  .latest-body { padding: 10px 6px 6px; display: grid; gap: 6px; justify-items: start; }
  .latest h3 { font-size: 18px; font-weight: 800; }
  .meta { display: flex; width: 100%; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 14px; color: var(--muted); }

  .upcoming :global(li) { display: flex; gap: 12px; align-items: baseline; padding: 11px 2px; font-size: 15px; }
  .upcoming :global(.dday) { flex: none; width: 48px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .upcoming :global(.date) { flex: none; width: 44px; color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
