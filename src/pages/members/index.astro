---
import Base from '../../layouts/Base.astro';
import { members, episodes, href } from '../../lib/data';
---
<Base title="멤버" current="members">
  <header class="page-head">
    <p class="eyebrow">SAY MY NAME</p>
    <h1>멤버</h1>
    <p>세이마이네임은 8명이에요. 공식으로 공개된 정보만, 출처와 함께 적어요.</p>
  </header>
  <div class="members">
    {members.map((m) => {
      const n = episodes.filter((e) => e.members.includes(m.id)).length;
      return (
        <a class="card lift member" href={href(`/members/${m.id}/`)} style={`--c:var(--m-${m.id})`}>
          <span class="swatch" aria-hidden="true"></span>
          <h2>{m.name}</h2>
          <span class="muted">{m.colorName} · 압축본 {n}편</span>
        </a>
      );
    })}
  </div>
</Base>
<style>
  .members { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 720px) { .members { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .member { padding: 18px; display: grid; gap: 4px; position: relative; overflow: hidden; }
  .member::after { content: ''; position: absolute; left: 18px; right: 18px; bottom: 0; height: 4px; border-radius: 4px 4px 0 0; background: var(--c); box-shadow: inset 0 0 0 1px var(--line); }
  .swatch { width: 40px; height: 40px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px var(--line); margin-bottom: 10px; }
  h2 { font-size: 22px; font-weight: 800; }
  .muted { font-size: 13px; }
</style>
