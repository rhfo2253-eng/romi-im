---
import { href } from '../lib/data';
// 쇼츠 모아보기 페이지는 없앴다. 쇼츠는 각 압축본 페이지와 멤버 페이지에서 본다.
const to = href('/episodes/');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>압축본으로 이동</title>
  </head>
  <body><a href={to}>압축본 페이지로 이동</a></body>
</html>
